{
  "name": "koh-vibe",
  "displayName": "Koh-Vibe",
  "description": "%extension.description%",
  "version": "1.5.0",
  "publisher": "tjacquin42",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/tjacquin42/koh-vibe.git" },
  "bugs": { "url": "https://github.com/tjacquin42/koh-vibe/issues" },
  "homepage": "https://github.com/tjacquin42/koh-vibe#readme",
  "engines": { "vscode": "^1.94.0", "node": ">=22" },
  "categories": ["AI", "Other"],
  "keywords": ["claude code", "claude", "anthropic", "cursor", "sessions", "dashboard", "tableau de bord", "hooks"],
  "icon": "resources/logo.png",
  "galleryBanner": { "color": "#0D1114", "theme": "dark" },
  "packageManager": "pnpm@10.25.0",
  "l10n": "./l10n",
  "main": "./out/main.js",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:kohVibeNext.cockpit"],
  "contributes": {
    "configuration": {
      "title": "Koh-Vibe",
      "properties": {
        "kohVibe.interface": {
          "type": "string",
          "enum": ["new", "classic"],
          "default": "new",
          "enumDescriptions": ["%config.kohVibe.interface.new%", "%config.kohVibe.interface.classic%"],
          "markdownDescription": "%config.kohVibe.interface.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "koh-vibe", "title": "Koh-Vibe", "icon": "resources/logo-mono.svg" }
      ]
    },
    "views": {
      "koh-vibe": [
        { "id": "kohVibe.sessions", "name": "%view.kohVibe.sessions.name%", "icon": "resources/logo-mono.svg", "initialSize": 20, "when": "config.kohVibe.interface == 'classic'" },
        { "id": "kohVibe.usage", "name": "%view.kohVibe.usage.name%", "type": "webview", "icon": "resources/logo-mono.svg", "initialSize": 3, "when": "config.kohVibe.interface == 'classic'" },
        { "id": "kohVibe.artifacts", "name": "%view.kohVibe.artifacts.name%", "icon": "resources/logo-mono.svg", "initialSize": 5, "visibility": "collapsed", "when": "config.kohVibe.interface == 'classic'" },
        { "id": "kohVibe.routines", "name": "%view.kohVibe.routines.name%", "icon": "resources/logo-mono.svg", "initialSize": 5, "visibility": "collapsed", "when": "config.kohVibe.interface == 'classic'" },
        { "id": "kohVibe.processes", "name": "%view.kohVibe.processes.name%", "icon": "resources/logo-mono.svg", "initialSize": 5, "visibility": "collapsed", "when": "config.kohVibe.interface == 'classic'" },
        { "id": "kohVibe.closed", "name": "%view.kohVibe.closed.name%", "icon": "resources/logo-mono.svg", "initialSize": 5, "visibility": "collapsed", "when": "config.kohVibe.interface == 'classic'" },
        { "id": "kohVibe.settings", "name": "%view.kohVibe.settings.name%", "icon": "resources/logo-mono.svg", "initialSize": 4, "when": "config.kohVibe.interface == 'classic'" },
        { "id": "kohVibeNext.sidebar", "name": "%view.kohVibeNext.sidebar.name%", "type": "webview", "icon": "resources/logo-mono.svg", "when": "config.kohVibe.interface != 'classic'" }
      ]
    },
    "commands": [
      { "command": "kohVibe.refresh", "title": "%command.kohVibe.refresh.title%", "category": "Koh-Vibe", "icon": "$(refresh)" },
      { "command": "kohVibe.rescanning", "title": "%command.kohVibe.rescanning.title%", "category": "Koh-Vibe", "icon": "$(sync~spin)", "enablement": "false" },
      { "command": "kohVibe.focusSession", "title": "%command.kohVibe.focusSession.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.focusSessionById", "title": "%command.kohVibe.focusSessionById.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.reopenSession", "title": "%command.kohVibe.reopenSession.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.toggleSetting", "title": "%command.kohVibe.toggleSetting.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.installHooks", "title": "%command.kohVibe.installHooks.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.uninstallHooks", "title": "%command.kohVibe.uninstallHooks.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.newGroup", "title": "%command.kohVibe.newGroup.title%", "category": "Koh-Vibe", "icon": "$(new-folder)" },
      { "command": "kohVibe.newSession", "title": "%command.kohVibe.newSession.title%", "category": "Koh-Vibe", "icon": "$(add)" },
      { "command": "kohVibe.newSessionInGroup", "title": "%command.kohVibe.newSessionInGroup.title%", "category": "Koh-Vibe", "icon": "$(add)" },
      { "command": "kohVibe.addFolderRule", "title": "%command.kohVibe.addFolderRule.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.openFolderRules", "title": "%command.kohVibe.openFolderRules.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.renameGroup", "title": "%command.kohVibe.renameGroup.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.colorGroup", "title": "%command.kohVibe.colorGroup.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.deleteGroup", "title": "%command.kohVibe.deleteGroup.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.chooseSound", "title": "%command.kohVibe.chooseSound.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.chooseVolume", "title": "%command.kohVibe.chooseVolume.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.chooseTabs", "title": "%command.kohVibe.chooseTabs.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.installSounds", "title": "%command.kohVibe.installSounds.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.removeSounds", "title": "%command.kohVibe.removeSounds.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.offerSounds", "title": "%command.kohVibe.offerSounds.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.replaySound", "title": "%command.kohVibe.replaySound.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.soundGroup.waiting", "title": "%command.kohVibe.soundGroup.waiting.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.soundGroup.done", "title": "%command.kohVibe.soundGroup.done.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.soundSession.waiting", "title": "%command.kohVibe.soundSession.waiting.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.soundSession.done", "title": "%command.kohVibe.soundSession.done.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.copySessionId", "title": "%command.kohVibe.copySessionId.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.copyProcessPid", "title": "%command.kohVibe.copyProcessPid.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.copyProcessCommand", "title": "%command.kohVibe.copyProcessCommand.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.killProcess", "title": "%command.kohVibe.killProcess.title%", "category": "Koh-Vibe", "icon": "$(stop-circle)" },
      { "command": "kohVibe.sleepSession", "title": "%command.kohVibe.sleepSession.title%", "category": "Koh-Vibe", "icon": { "light": "resources/moon-light.svg", "dark": "resources/moon-dark.svg" } },
      { "command": "kohVibe.forgetSession", "title": "%command.kohVibe.forgetSession.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.closeSession", "title": "%command.kohVibe.closeSession.title%", "category": "Koh-Vibe", "icon": "$(trash)" },
      { "command": "kohVibe.refreshUsage", "title": "%command.kohVibe.refreshUsage.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.refreshRoutines", "title": "%command.kohVibe.refreshRoutines.title%", "category": "Koh-Vibe", "icon": "$(refresh)" },
      { "command": "kohVibe.openRoutine", "title": "%command.kohVibe.openRoutine.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.copyRoutineLink", "title": "%command.kohVibe.copyRoutineLink.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.runRoutine", "title": "%command.kohVibe.runRoutine.title%", "category": "Koh-Vibe", "icon": "$(play)" },
      { "command": "kohVibe.pauseRoutine", "title": "%command.kohVibe.pauseRoutine.title%", "category": "Koh-Vibe", "icon": "$(debug-pause)" },
      { "command": "kohVibe.resumeRoutine", "title": "%command.kohVibe.resumeRoutine.title%", "category": "Koh-Vibe", "icon": "$(debug-start)" },
      { "command": "kohVibe.refreshArtifacts", "title": "%command.kohVibe.refreshArtifacts.title%", "category": "Koh-Vibe", "icon": "$(refresh)" },
      { "command": "kohVibe.openArtifact", "title": "%command.kohVibe.openArtifact.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.copyArtifactLink", "title": "%command.kohVibe.copyArtifactLink.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.renameArtifact", "title": "%command.kohVibe.renameArtifact.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.pinArtifact", "title": "%command.kohVibe.pinArtifact.title%", "category": "Koh-Vibe", "icon": "$(pin)" },
      { "command": "kohVibe.unpinArtifact", "title": "%command.kohVibe.unpinArtifact.title%", "category": "Koh-Vibe", "icon": "$(pinned)" },
      { "command": "kohVibe.fileArtifact", "title": "%command.kohVibe.fileArtifact.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.fileArtifactInFolder", "title": "%command.kohVibe.fileArtifactInFolder.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.unfileFolderArtifact", "title": "%command.kohVibe.unfileFolderArtifact.title%", "category": "Koh-Vibe", "icon": "$(close)" },
      { "command": "kohVibe.searchSessions", "title": "%command.kohVibe.searchSessions.title%", "category": "Koh-Vibe", "icon": "$(search)" },
      { "command": "kohVibe.renameArtifactProject", "title": "%command.kohVibe.renameArtifactProject.title%", "category": "Koh-Vibe" },
      { "command": "kohVibe.switchInterface", "title": "%command.kohVibe.switchInterface.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.openCockpit", "title": "%command.kohVibeNext.openCockpit.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.reload", "title": "%command.kohVibeNext.reload.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.session.open", "title": "%command.kohVibeNext.ctx.session.open.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.session.sheet", "title": "%command.kohVibeNext.ctx.session.sheet.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.session.sleep", "title": "%command.kohVibeNext.ctx.session.sleep.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.session.close", "title": "%command.kohVibeNext.ctx.session.close.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.session.copyId", "title": "%command.kohVibeNext.ctx.session.copyId.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.closed.reopen", "title": "%command.kohVibeNext.ctx.closed.reopen.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.closed.copyId", "title": "%command.kohVibeNext.ctx.closed.copyId.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.folder.newSession", "title": "%command.kohVibeNext.ctx.folder.newSession.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.unfiled.newSession", "title": "%command.kohVibeNext.ctx.unfiled.newSession.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.folder.addRule", "title": "%command.kohVibeNext.ctx.folder.addRule.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.folder.openRules", "title": "%command.kohVibeNext.ctx.folder.openRules.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.folder.rename", "title": "%command.kohVibeNext.ctx.folder.rename.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.folder.color", "title": "%command.kohVibeNext.ctx.folder.color.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.folder.delete", "title": "%command.kohVibeNext.ctx.folder.delete.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.artifact.open", "title": "%command.kohVibeNext.ctx.artifact.open.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.artifact.pin", "title": "%command.kohVibeNext.ctx.artifact.pin.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.artifact.unpin", "title": "%command.kohVibeNext.ctx.artifact.unpin.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.artifact.rename", "title": "%command.kohVibeNext.ctx.artifact.rename.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.artifact.copyLink", "title": "%command.kohVibeNext.ctx.artifact.copyLink.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.artifact.delete", "title": "%command.kohVibeNext.ctx.artifact.delete.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.routine.run", "title": "%command.kohVibeNext.ctx.routine.run.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.routine.pause", "title": "%command.kohVibeNext.ctx.routine.pause.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.routine.resume", "title": "%command.kohVibeNext.ctx.routine.resume.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.routine.open", "title": "%command.kohVibeNext.ctx.routine.open.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.routine.copyLink", "title": "%command.kohVibeNext.ctx.routine.copyLink.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.process.copyCommand", "title": "%command.kohVibeNext.ctx.process.copyCommand.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.process.copyPid", "title": "%command.kohVibeNext.ctx.process.copyPid.title%", "category": "Koh-Vibe" },
      { "command": "kohVibeNext.ctx.process.kill", "title": "%command.kohVibeNext.ctx.process.kill.title%", "category": "Koh-Vibe" }
    ],
    "keybindings": [
      { "command": "kohVibe.replaySound", "key": "right", "when": "kohVibe.pickingSound && inQuickOpen" }
    ],
    "menus": {
      "view/title": [
        { "command": "kohVibe.refresh", "when": "view == kohVibe.sessions && !kohVibe.rescanning", "group": "navigation" },
        { "command": "kohVibe.rescanning", "when": "view == kohVibe.sessions && kohVibe.rescanning", "group": "navigation" },
        { "command": "kohVibe.searchSessions", "when": "view == kohVibe.sessions", "group": "navigation@-1" },
        { "command": "kohVibe.newSession", "when": "view == kohVibe.sessions", "group": "navigation@0" },
        { "command": "kohVibe.newGroup", "when": "view == kohVibe.sessions", "group": "navigation" },
        { "command": "kohVibe.refreshRoutines", "when": "view == kohVibe.routines", "group": "navigation" },
        { "command": "kohVibe.refreshArtifacts", "when": "view == kohVibe.artifacts", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "kohVibe.newSessionInGroup", "when": "view == kohVibe.sessions && (viewItem == group || viewItem == unfiled)", "group": "new@1" },
        { "command": "kohVibe.newSessionInGroup", "when": "view == kohVibe.sessions && (viewItem == group || viewItem == unfiled)", "group": "inline" },
        { "command": "kohVibe.addFolderRule", "when": "view == kohVibe.sessions && viewItem == group", "group": "rules@1" },
        { "command": "kohVibe.openFolderRules", "when": "view == kohVibe.sessions && viewItem == group", "group": "rules@2" },
        { "command": "kohVibe.renameGroup", "when": "view == kohVibe.sessions && viewItem == group" },
        { "command": "kohVibe.colorGroup", "when": "view == kohVibe.sessions && viewItem == group" },
        { "command": "kohVibe.soundGroup.waiting", "when": "view == kohVibe.sessions && viewItem == group", "group": "son@1" },
        { "command": "kohVibe.soundGroup.done", "when": "view == kohVibe.sessions && viewItem == group", "group": "son@2" },
        { "command": "kohVibe.deleteGroup", "when": "view == kohVibe.sessions && viewItem == group", "group": "zzz@1" },
        { "command": "kohVibe.copyProcessCommand", "when": "(view == kohVibe.sessions || view == kohVibe.processes) && viewItem =~ /^(process|orphan)/", "group": "copy@1" },
        { "command": "kohVibe.copyProcessPid", "when": "(view == kohVibe.sessions || view == kohVibe.processes) && viewItem =~ /^(process|orphan)/", "group": "copy@2" },
        { "command": "kohVibe.killProcess", "when": "(view == kohVibe.sessions || view == kohVibe.processes) && viewItem =~ /^(process|orphan)/", "group": "inline" },
        { "command": "kohVibe.killProcess", "when": "(view == kohVibe.sessions || view == kohVibe.processes) && viewItem =~ /^(process|orphan)/", "group": "process@1" },
        { "command": "kohVibe.copySessionId", "when": "view == kohVibe.sessions && viewItem =~ /^session/", "group": "copy@1" },
        { "command": "kohVibe.copySessionId", "when": "view == kohVibe.closed && viewItem == closedSession", "group": "copy@1" },
        { "command": "kohVibe.soundSession.waiting", "when": "view == kohVibe.sessions && viewItem =~ /^session/", "group": "son@1" },
        { "command": "kohVibe.soundSession.done", "when": "view == kohVibe.sessions && viewItem =~ /^session/", "group": "son@2" },
        { "command": "kohVibe.forgetSession", "when": "view == kohVibe.sessions && viewItem =~ /^session/", "group": "zzz@1" },
        { "command": "kohVibe.sleepSession", "when": "view == kohVibe.sessions && viewItem == session", "group": "inline@1" },
        { "command": "kohVibe.closeSession", "when": "view == kohVibe.sessions && viewItem =~ /^session/", "group": "inline@2" },
        { "command": "kohVibe.copyRoutineLink", "when": "view == kohVibe.routines && viewItem =~ /^routine/", "group": "copy@1" },
        { "command": "kohVibe.runRoutine", "when": "view == kohVibe.routines && viewItem == routine.enabled", "group": "inline@1" },
        { "command": "kohVibe.pauseRoutine", "when": "view == kohVibe.routines && viewItem == routine.enabled", "group": "inline@2" },
        { "command": "kohVibe.resumeRoutine", "when": "view == kohVibe.routines && viewItem == routine.paused", "group": "inline@2" },
        { "command": "kohVibe.runRoutine", "when": "view == kohVibe.routines && viewItem == routine.enabled", "group": "routine@1" },
        { "command": "kohVibe.pauseRoutine", "when": "view == kohVibe.routines && viewItem == routine.enabled", "group": "routine@2" },
        { "command": "kohVibe.resumeRoutine", "when": "view == kohVibe.routines && viewItem == routine.paused", "group": "routine@2" },
        { "command": "kohVibe.copyArtifactLink", "when": "view == kohVibe.artifacts && viewItem =~ /^artifact/", "group": "copy@1" },
        { "command": "kohVibe.renameArtifact", "when": "view == kohVibe.artifacts && viewItem =~ /^artifact/", "group": "artifact@1" },
        { "command": "kohVibe.pinArtifact", "when": "view == kohVibe.artifacts && viewItem == artifact.unpinned", "group": "inline@1" },
        { "command": "kohVibe.unpinArtifact", "when": "view == kohVibe.artifacts && viewItem == artifact.pinned", "group": "inline@1" },
        { "command": "kohVibe.pinArtifact", "when": "view == kohVibe.artifacts && viewItem == artifact.unpinned", "group": "artifact@2" },
        { "command": "kohVibe.unpinArtifact", "when": "view == kohVibe.artifacts && viewItem == artifact.pinned", "group": "artifact@2" },
        { "command": "kohVibe.fileArtifact", "when": "view == kohVibe.artifacts && viewItem =~ /^artifact/", "group": "artifact@3" },
        { "command": "kohVibe.fileArtifactInFolder", "when": "view == kohVibe.artifacts && viewItem =~ /^artifact/", "group": "artifact@4" },
        { "command": "kohVibe.copyArtifactLink", "when": "view == kohVibe.sessions && viewItem == folderArtifact", "group": "copy@1" },
        { "command": "kohVibe.unfileFolderArtifact", "when": "view == kohVibe.sessions && viewItem == folderArtifact", "group": "inline@1" },
        { "command": "kohVibe.unfileFolderArtifact", "when": "view == kohVibe.sessions && viewItem == folderArtifact", "group": "zzz@1" },
        { "command": "kohVibe.renameArtifactProject", "when": "view == kohVibe.artifacts && viewItem == project.named", "group": "project@1" }
      ],
      "webview/context": [
        { "command": "kohVibeNext.ctx.session.open", "when": "webviewSection == 'kvnSession'", "group": "1_open@1" },
        { "command": "kohVibeNext.ctx.session.sheet", "when": "webviewSection == 'kvnSession'", "group": "1_open@2" },
        { "command": "kohVibeNext.ctx.session.sleep", "when": "webviewSection == 'kvnSession' && !kvnEnded", "group": "2_state@1" },
        { "command": "kohVibeNext.ctx.session.close", "when": "webviewSection == 'kvnSession'", "group": "2_state@2" },
        { "command": "kohVibeNext.ctx.session.copyId", "when": "webviewSection == 'kvnSession'", "group": "9_copy@1" },
        { "command": "kohVibeNext.ctx.closed.reopen", "when": "webviewSection == 'kvnClosed' && kvnResumable", "group": "1_open@1" },
        { "command": "kohVibeNext.ctx.closed.copyId", "when": "webviewSection == 'kvnClosed'", "group": "9_copy@1" },
        { "command": "kohVibeNext.ctx.folder.newSession", "when": "webviewSection == 'kvnFolder'", "group": "1_new@1" },
        { "command": "kohVibeNext.ctx.unfiled.newSession", "when": "webviewSection == 'kvnUnfiled'", "group": "1_new@1" },
        { "command": "kohVibeNext.ctx.folder.addRule", "when": "webviewSection == 'kvnFolder'", "group": "2_rules@1" },
