{
  "name": "koh-vibe-next",
  "displayName": "Koh-Vibe Next",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "tjacquin42",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/tjacquin42/koh-vibe.git" },
  "engines": { "vscode": "^1.94.0", "node": ">=22" },
  "categories": ["AI", "Other"],
  "packageManager": "pnpm@10.25.0",
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "kohVibeNext", "title": "Koh-Vibe Next", "icon": "resources/logo-mono.svg" }
      ]
    },
    "views": {
      "kohVibeNext": [
        { "id": "kohVibeNext.sidebar", "name": "%view.kohVibeNext.sidebar.name%", "type": "webview", "icon": "resources/logo-mono.svg" }
      ]
    },
    "commands": [
      { "command": "kohVibeNext.openCockpit", "title": "%command.kohVibeNext.openCockpit.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.reload", "title": "%command.kohVibeNext.reload.title%", "category": "Koh-Vibe Next" }
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-host.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.view.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/geist": "^5.2.6",
    "@fontsource-variable/geist-mono": "^5.2.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.94.0",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "^0.25.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
