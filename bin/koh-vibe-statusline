#!/bin/zsh -f
# koh-vibe-statusline — captures the Claude Code statusline snapshot, then
# delegates to the command that held the spot before us.
#
# Claude Code offers only ONE statusline slot. Taking it without handing back
# control would break the tool that sat there (Vibe Island, for instance,
# which reads its usage limits from it). The first argument therefore carries
# the previous command, base64-encoded — encoded because it contains quotes
# and apostrophes that no level of quoting gets through cleanly.
#
# Like the hooks bridge: parses nothing, never writes to stdout on its own,
# always exits 0. What goes to stdout is the delegate's output, and only
# that — it is what Claude Code displays.
emulate -L zsh

# Also covers the failure of a redirection, which zsh reports on its own
# stderr even before running the guarded command. Invariant of the bridge:
# never disturb the session that calls it.
exec 2>/dev/null

DIR="${KOH_VIBE_HOME:-$HOME/.koh-vibe}"
INPUT="$(/bin/cat)"

# The full snapshot, as is: the extension reads and validates it, the bridge
# does not interpret it. Atomic write — a window can be reading while we write.
if [[ -d "$DIR" && -n "$INPUT" ]]; then
  TMP="$DIR/.tmp-status-$$"
  printf '%s' "$INPUT" > "$TMP" && /bin/mv -f "$TMP" "$DIR/status.json"
fi

PREV="${1:-}"
if [[ -n "$PREV" ]]; then
  CMD="$(printf '%s' "$PREV" | /usr/bin/base64 -d)"
  # The SAME input is passed back to the delegate: it expects Claude Code's
  # JSON, not an empty stream.
  [[ -n "$CMD" ]] && printf '%s' "$INPUT" | /bin/sh -c "$CMD"
fi

exit 0
