#!/bin/zsh -f
# koh-vibe-bridge — drops a Claude Code hook payload into the spool.
# Parses nothing. Never writes to stdout. Always exits 0.
# -f stops the user's startup files from polluting the hooks protocol.
emulate -L zsh
zmodload zsh/datetime 2>/dev/null || true

EVENT="${1:-unknown}"
DIR="${KOH_VIBE_HOME:-$HOME/.koh-vibe}/events"
[[ -d "$DIR" ]] || exit 0

# Moving a `2>/dev/null` onto each redirection is not enough: zsh can report
# the failure of the redirection itself (e.g. permission denied on
# "> $TMP") on its own stderr, before the guarded command even runs. `exec`
# redirects the whole script's stderr once and for all, which covers this
# case too. Invariant of the bridge: never disturb the Claude Code session
# that calls it, neither on stdout, nor on stderr, nor through a nonzero
# exit code.
exec 2>/dev/null

STAMP="$(printf '%.0f' $(( ${EPOCHREALTIME:-0} * 1000 )) 2>/dev/null)"
[[ -n "$STAMP" && "$STAMP" != "0" ]] || STAMP="$(/bin/date +%s)000"

# A pid that is not zero-padded sorts badly, lexicographically, within the
# same millisecond ("9" > "10" in string sort, even though 9 < 10): two
# events posted in the same millisecond by processes whose ids have
# different widths could then apply in the wrong order. Fixed width, wide
# enough that a real pid will never reach it.
PID="$(printf '%010d' "$$")"

TMP="$DIR/.tmp-$PID-$EVENT"
OUT="$DIR/$STAMP-$PID-$EVENT.json"

{
  printf '{"event":"%s","at":%s,"entrypoint":"%s","termProgram":"%s","payload":' \
    "$EVENT" "$STAMP" "${CLAUDE_CODE_ENTRYPOINT:-}" "${TERM_PROGRAM:-}"
  /bin/cat
  printf '}\n'
} > "$TMP" 2>/dev/null && /bin/mv -f "$TMP" "$OUT" 2>/dev/null

exit 0
