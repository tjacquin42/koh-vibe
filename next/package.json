{
  "name": "koh-vibe-next",
  "displayName": "Koh-Vibe Next",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "tjacquin42",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/tjacquin42/koh-vibe.git" },
  "engines": { "vscode": "^1.94.0", "node": ">=22" },
  "categories": ["AI", "Other"],
  "packageManager": "pnpm@10.25.0",
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:kohVibeNext.cockpit"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "kohVibeNext", "title": "Koh-Vibe Next", "icon": "resources/logo-mono.svg" }
      ]
    },
    "views": {
      "kohVibeNext": [
        { "id": "kohVibeNext.sidebar", "name": "%view.kohVibeNext.sidebar.name%", "type": "webview", "icon": "resources/logo-mono.svg" }
      ]
    },
    "commands": [
      { "command": "kohVibeNext.openCockpit", "title": "%command.kohVibeNext.openCockpit.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.reload", "title": "%command.kohVibeNext.reload.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.session.open", "title": "%command.kohVibeNext.ctx.session.open.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.session.sheet", "title": "%command.kohVibeNext.ctx.session.sheet.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.session.sleep", "title": "%command.kohVibeNext.ctx.session.sleep.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.session.close", "title": "%command.kohVibeNext.ctx.session.close.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.session.copyId", "title": "%command.kohVibeNext.ctx.session.copyId.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.closed.reopen", "title": "%command.kohVibeNext.ctx.closed.reopen.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.closed.copyId", "title": "%command.kohVibeNext.ctx.closed.copyId.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.folder.newSession", "title": "%command.kohVibeNext.ctx.folder.newSession.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.unfiled.newSession", "title": "%command.kohVibeNext.ctx.unfiled.newSession.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.folder.addRule", "title": "%command.kohVibeNext.ctx.folder.addRule.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.folder.openRules", "title": "%command.kohVibeNext.ctx.folder.openRules.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.folder.rename", "title": "%command.kohVibeNext.ctx.folder.rename.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.folder.color", "title": "%command.kohVibeNext.ctx.folder.color.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.folder.delete", "title": "%command.kohVibeNext.ctx.folder.delete.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.artifact.open", "title": "%command.kohVibeNext.ctx.artifact.open.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.artifact.pin", "title": "%command.kohVibeNext.ctx.artifact.pin.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.artifact.unpin", "title": "%command.kohVibeNext.ctx.artifact.unpin.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.artifact.rename", "title": "%command.kohVibeNext.ctx.artifact.rename.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.artifact.copyLink", "title": "%command.kohVibeNext.ctx.artifact.copyLink.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.artifact.delete", "title": "%command.kohVibeNext.ctx.artifact.delete.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.routine.run", "title": "%command.kohVibeNext.ctx.routine.run.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.routine.pause", "title": "%command.kohVibeNext.ctx.routine.pause.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.routine.resume", "title": "%command.kohVibeNext.ctx.routine.resume.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.routine.open", "title": "%command.kohVibeNext.ctx.routine.open.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.routine.copyLink", "title": "%command.kohVibeNext.ctx.routine.copyLink.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.process.copyCommand", "title": "%command.kohVibeNext.ctx.process.copyCommand.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.process.copyPid", "title": "%command.kohVibeNext.ctx.process.copyPid.title%", "category": "Koh-Vibe Next" },
      { "command": "kohVibeNext.ctx.process.kill", "title": "%command.kohVibeNext.ctx.process.kill.title%", "category": "Koh-Vibe Next" }
    ],
    "menus": {
      "webview/context": [
        { "command": "kohVibeNext.ctx.session.open", "when": "webviewSection == 'kvnSession'", "group": "1_open@1" },
        { "command": "kohVibeNext.ctx.session.sheet", "when": "webviewSection == 'kvnSession'", "group": "1_open@2" },
        { "command": "kohVibeNext.ctx.session.sleep", "when": "webviewSection == 'kvnSession' && !kvnEnded", "group": "2_state@1" },
        { "command": "kohVibeNext.ctx.session.close", "when": "webviewSection == 'kvnSession'", "group": "2_state@2" },
        { "command": "kohVibeNext.ctx.session.copyId", "when": "webviewSection == 'kvnSession'", "group": "9_copy@1" },
        { "command": "kohVibeNext.ctx.closed.reopen", "when": "webviewSection == 'kvnClosed' && kvnResumable", "group": "1_open@1" },
        { "command": "kohVibeNext.ctx.closed.copyId", "when": "webviewSection == 'kvnClosed'", "group": "9_copy@1" },
        { "command": "kohVibeNext.ctx.folder.newSession", "when": "webviewSection == 'kvnFolder'", "group": "1_new@1" },
        { "command": "kohVibeNext.ctx.unfiled.newSession", "when": "webviewSection == 'kvnUnfiled'", "group": "1_new@1" },
        { "command": "kohVibeNext.ctx.folder.addRule", "when": "webviewSection == 'kvnFolder'", "group": "2_rules@1" },
        { "command": "kohVibeNext.ctx.folder.openRules", "when": "webviewSection == 'kvnFolder'", "group": "2_rules@2" },
        { "command": "kohVibeNext.ctx.folder.rename", "when": "webviewSection == 'kvnFolder'", "group": "3_edit@1" },
        { "command": "kohVibeNext.ctx.folder.color", "when": "webviewSection == 'kvnFolder'", "group": "3_edit@2" },
        { "command": "kohVibeNext.ctx.folder.delete", "when": "webviewSection == 'kvnFolder'", "group": "9_delete@1" },
        { "command": "kohVibeNext.ctx.artifact.open", "when": "webviewSection == 'kvnArtifact'", "group": "1_open@1" },
        { "command": "kohVibeNext.ctx.artifact.pin", "when": "webviewSection == 'kvnArtifact' && !kvnPinned", "group": "2_edit@1" },
        { "command": "kohVibeNext.ctx.artifact.unpin", "when": "webviewSection == 'kvnArtifact' && kvnPinned", "group": "2_edit@1" },
        { "command": "kohVibeNext.ctx.artifact.rename", "when": "webviewSection == 'kvnArtifact'", "group": "2_edit@2" },
        { "command": "kohVibeNext.ctx.artifact.copyLink", "when": "webviewSection == 'kvnArtifact'", "group": "8_copy@1" },
        { "command": "kohVibeNext.ctx.artifact.delete", "when": "webviewSection == 'kvnArtifact'", "group": "9_delete@1" },
        { "command": "kohVibeNext.ctx.routine.run", "when": "webviewSection == 'kvnRoutine' && kvnCanRun", "group": "1_run@1" },
        { "command": "kohVibeNext.ctx.routine.pause", "when": "webviewSection == 'kvnRoutine' && kvnEnabled", "group": "1_run@2" },
        { "command": "kohVibeNext.ctx.routine.resume", "when": "webviewSection == 'kvnRoutine' && kvnCanResume", "group": "1_run@2" },
        { "command": "kohVibeNext.ctx.routine.open", "when": "webviewSection == 'kvnRoutine'", "group": "2_open@1" },
        { "command": "kohVibeNext.ctx.routine.copyLink", "when": "webviewSection == 'kvnRoutine'", "group": "8_copy@1" },
        { "command": "kohVibeNext.ctx.process.copyCommand", "when": "webviewSection == 'kvnProcess'", "group": "8_copy@1" },
        { "command": "kohVibeNext.ctx.process.copyPid", "when": "webviewSection == 'kvnProcess'", "group": "8_copy@2" },
        { "command": "kohVibeNext.ctx.process.kill", "when": "webviewSection == 'kvnProcess'", "group": "9_kill@1" }
      ],
      "commandPalette": [
        { "command": "kohVibeNext.ctx.session.open", "when": "false" },
        { "command": "kohVibeNext.ctx.session.sheet", "when": "false" },
        { "command": "kohVibeNext.ctx.session.sleep", "when": "false" },
        { "command": "kohVibeNext.ctx.session.close", "when": "false" },
        { "command": "kohVibeNext.ctx.session.copyId", "when": "false" },
        { "command": "kohVibeNext.ctx.closed.reopen", "when": "false" },
        { "command": "kohVibeNext.ctx.closed.copyId", "when": "false" },
        { "command": "kohVibeNext.ctx.folder.newSession", "when": "false" },
        { "command": "kohVibeNext.ctx.unfiled.newSession", "when": "false" },
        { "command": "kohVibeNext.ctx.folder.addRule", "when": "false" },
        { "command": "kohVibeNext.ctx.folder.openRules", "when": "false" },
        { "command": "kohVibeNext.ctx.folder.rename", "when": "false" },
        { "command": "kohVibeNext.ctx.folder.color", "when": "false" },
        { "command": "kohVibeNext.ctx.folder.delete", "when": "false" },
        { "command": "kohVibeNext.ctx.artifact.open", "when": "false" },
        { "command": "kohVibeNext.ctx.artifact.pin", "when": "false" },
        { "command": "kohVibeNext.ctx.artifact.unpin", "when": "false" },
        { "command": "kohVibeNext.ctx.artifact.rename", "when": "false" },
        { "command": "kohVibeNext.ctx.artifact.copyLink", "when": "false" },
        { "command": "kohVibeNext.ctx.artifact.delete", "when": "false" },
        { "command": "kohVibeNext.ctx.routine.run", "when": "false" },
        { "command": "kohVibeNext.ctx.routine.pause", "when": "false" },
        { "command": "kohVibeNext.ctx.routine.resume", "when": "false" },
        { "command": "kohVibeNext.ctx.routine.open", "when": "false" },
        { "command": "kohVibeNext.ctx.routine.copyLink", "when": "false" },
        { "command": "kohVibeNext.ctx.process.copyCommand", "when": "false" },
        { "command": "kohVibeNext.ctx.process.copyPid", "when": "false" },
        { "command": "kohVibeNext.ctx.process.kill", "when": "false" }
      ]
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-host.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.view.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/geist": "^5.2.6",
    "@fontsource-variable/geist-mono": "^5.2.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.94.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "^0.25.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
