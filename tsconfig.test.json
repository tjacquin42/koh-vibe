{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The main tsconfig only covers `src`: that is what `tsc` compiles to `out`,
  // and tests have no business there. But "not compiled" had turned into "not
  // checked" — a test fixture survived a type change without anything flagging it.
  // This file produces nothing: it only runs the type checker over both folders.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "rootDir": "." },
  // `vitest.config.ts` stays out: it is an ES module, and the base compiles to
  // CommonJS for the extension host. Type-checking it here would call for a
  // second module setting for a six-line configuration file.
  "include": ["src", "test"]
}
